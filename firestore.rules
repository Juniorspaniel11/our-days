rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(cid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;
    }

    // Each person's own profile: name, city, time zone, which space they belong to
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // The shared space for the two of you
    match /couples/{cid} {
      allow read: if isMember(cid);
      // Creating a space: you must be its only member
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      // Joining with the code: only adds yourself, and only while there is one member
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && resource.data.members.size() == 1
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);

      // Each person's plan: both can read, only the owner can change it
      match /people/{uid} {
        allow read: if isMember(cid);
        allow write: if isMember(cid) && request.auth.uid == uid;
        match /days/{day} {
          allow read: if isMember(cid);
          allow write: if isMember(cid) && request.auth.uid == uid;
        }
        // The photo each of you picks: both can see it, only the owner changes it
        match /extra/{doc} {
          allow read: if isMember(cid);
          allow write: if isMember(cid) && request.auth.uid == uid;
        }
      }

      // Visit countdown, prayer, plans: both can read and change
      match /shared/{doc} {
        allow read, write: if isMember(cid);
      }

      // Us tab: dates, answers, games and topic choices. Both can read and change
      match /us/{doc} {
        allow read, write: if isMember(cid);
      }
      // Photos, doodles, jar notes and hearts: both can read, you can only add as yourself and delete your own
      match /{col}/{id} {
        allow read: if isMember(cid) && col in ['moments', 'jar', 'nudges', 'letters'];
        allow create: if isMember(cid) && col in ['moments', 'jar', 'nudges', 'letters'] && request.resource.data.from == request.auth.uid;
        allow delete: if isMember(cid) && col in ['moments', 'jar', 'nudges', 'letters'] && resource.data.from == request.auth.uid;
        // the person a letter is for can mark it opened
        allow update: if isMember(cid) && col == 'letters' && resource.data.to == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openedAt']);
      }
    }
  }
}
